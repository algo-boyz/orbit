---
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);

const features = [
  { title: t('feat.1.title'), body: t('feat.1.body') },
  { title: t('feat.2.title'), body: t('feat.2.body') },
  { title: t('feat.3.title'), body: t('feat.3.body') },
];
---

<section class="features" id="capabilities">
  <div class="inner">
    <p class="section-label">{t('feat.label')}</p>
    <h2>{t('feat.title')}</h2>
    <div class="grid">
      {features.map((f) => (
        <article class="card">
          <div class="icon" aria-hidden="true"></div>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .features {
    border-top: 1px solid var(--border);
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 4.5rem 1.5rem;
  }

  .section-label {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.15rem);
  }

  .intro {
    margin: 0 0 2.75rem;
    max-width: 40rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .grid {
    display: grid;
    gap: 1.25rem;
  }

  .card {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: rgba(59, 130, 246, 0.35);
  }

  .icon {
    width: 2rem;
    height: 2rem;
    margin-bottom: 1rem;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--accent-soft), rgba(34, 211, 238, 0.12));
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
