---
const features = [
  {
    title: "Real-time multi-modal detection",
    body: "Persons, vehicles, plates, and objects of interest — analyzed continuously from live streams against authorized watchlists.",
  },
  {
    title: "Works with what you already have",
    body: "Fixed cameras, ALPR, dash cams, body-worn cameras, drones, and mobile sources become an active detection network.",
  },
  {
    title: "Edge-first, cloud-optional",
    body: "Processing happens at or near the point of capture. Critical capability remains when connectivity is limited or denied.",
  },
  {
    title: "Agency control by design",
    body: "Models, data, access, and operational policy stay under your authority. AI surfaces awareness; humans decide the response.",
  },
  {
    title: "Immediate operational alerts",
    body: "When a match is identified, actionable signals can reach officers, dispatch, and command while the event is still unfolding.",
  },
  {
    title: "Auditable & policy-aligned",
    body: "Every detection path is designed for oversight, compliance, and human authority — not autonomous enforcement.",
  },
];
---

<section class="features" id="capabilities">
  <div class="inner">
    <p class="section-label">Capabilities</p>
    <h2>From passive cameras to active intelligence</h2>
    <p class="intro">
      Agent Jetson turns existing video infrastructure into a real-time operational capability —
      detecting, correlating, and alerting without waiting for after-the-fact review.
    </p>
    <div class="grid">
      {features.map((f) => (
        <article class="card">
          <div class="icon" aria-hidden="true"></div>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    border-top: 1px solid var(--border);
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 4.5rem 1.5rem;
  }

  .section-label {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.15rem);
  }

  .intro {
    margin: 0 0 2.75rem;
    max-width: 40rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .grid {
    display: grid;
    gap: 1.25rem;
  }

  .card {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: rgba(59, 130, 246, 0.35);
  }

  .icon {
    width: 2rem;
    height: 2rem;
    margin-bottom: 1rem;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--accent-soft), rgba(34, 211, 238, 0.12));
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
