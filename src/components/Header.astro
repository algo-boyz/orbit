---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import logo from '../assets/veruvian-man.png';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'en';

const homeHref = locale === 'en' ? '/' : `/${locale}/`;
const blogHref = locale === 'en' ? '/blog/' : `/${locale}/blog/`;

const links = [
  { href: `${homeHref}#capabilities`, label: t('nav.capabilities') },
  { href: `${homeHref}#edge`, label: t('nav.edge') },
  { href: blogHref, label: t('nav.blog') },
  { href: `${homeHref}#contact`, label: t('nav.contact') },
];
---

<header class="header">
  <div class="inner">
    <a href={homeHref} class="logo" aria-label={t('nav.homeAria')}>
      <img src={logo.src} alt="" width="32" height="32" class="mark" />
      <span class="name">AgentJetson</span>
    </a>
    <nav class="nav">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>
    <div class="actions">
      <LanguageSwitcher />
      <a href={`${homeHref}#contact`} class="cta">{t('nav.cta')}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px);
    background: rgba(7, 9, 15, 0.75);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
  }

  .mark {
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    display: block;
  }

  .name {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .nav {
    display: none;
    gap: 1.75rem;
  }

  .nav a {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  .nav a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 0.15s, box-shadow 0.15s;
  }

  .cta:hover {
    background: #2563eb;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  @media (min-width: 768px) {
    .nav {
      display: flex;
    }
  }
</style>
