---
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);
---

<section class="cta" id="contact">
  <!-- soft background glow / image -->
  <div class="bg-layer" aria-hidden="true">
    <img src="/bg-light.webp" alt="" class="bg-image" />
  </div>

  <div class="container">
    <div class="content">
      <p class="section-label">{t('cta.label')}</p>
      <h2>{t('cta.title')}</h2>
      <p class="lede">{t('cta.lede')}</p>

      <form class="form" id="briefing-form" novalidate>
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

        <div class="row">
          <label>
            <span>{t('cta.name')}</span>
            <input type="text" name="name" required autocomplete="name" placeholder={t('cta.namePlaceholder')} />
          </label>
          <label>
            <span>{t('cta.email')}</span>
            <input type="email" name="email" required autocomplete="email" placeholder={t('cta.emailPlaceholder')} />
          </label>
        </div>

        <label>
          <span>{t('cta.org')}</span>
          <input type="text" name="organization" autocomplete="organization" placeholder={t('cta.orgPlaceholder')} />
        </label>

        <label>
          <span>{t('cta.message')}</span>
          <textarea name="message" rows="4" required placeholder={t('cta.messagePlaceholder')}></textarea>
        </label>

        <button type="submit" class="btn" id="submit-btn">
          {t('cta.submit')}
        </button>

        <p class="status" id="form-status" role="status" aria-live="polite" hidden></p>
      </form>

      <p class="note">Or email <a href="mailto:hello@agentjetson.ai">hello@agentjetson.ai</a> · agentjetson.ai</p>
    </div>

    <div class="visual" aria-hidden="true">
      <video
        autoplay
        loop
        muted
        playsinline
        class="cube"
        width="480"
        height="480"
        src="/cube.mp4"
      ></video>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('briefing-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  if (form && statusEl && btn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form));

      btn.disabled = true;
      statusEl.hidden = true;
      statusEl.className = 'status';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const json = await res.json();

        statusEl.hidden = false;
        if (json.success) {
          statusEl.classList.add('success');
          statusEl.textContent = json.message || 'Thank you. We’ll be in touch shortly.';
          form.reset();
        } else {
          statusEl.classList.add('error');
          statusEl.textContent = json.message || 'Something went wrong.';
        }
      } catch {
        statusEl.hidden = false;
        statusEl.classList.add('error');
        statusEl.textContent = 'Network error. Please try again or email us directly.';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .cta {
    position: relative;
    border-top: 1px solid var(--border);
    overflow: hidden;
    isolation: isolate;
  }

  /* Background image – soft, right-biased */
  .bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .bg-image {
    position: absolute;
    right: -5%;
    top: 50%;
    transform: translateY(-50%);
    width: min(65vw, 680px);
    height: auto;
    opacity: 0.28;
    mask-image: radial-gradient(ellipse 65% 70% at 75% 50%, black 15%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 65% 70% at 75% 50%, black 15%, transparent 72%);
  }

  .container {
    position: relative;
    z-index: 1;
    max-width: var(--max);
    margin: 0 auto;
    padding: 5.5rem 1.5rem 6.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 2rem;
      padding: 6.5rem 1.5rem 7.5rem;
    }
  }

  .content {
    max-width: 28rem;
    position: relative;
    z-index: 2;
  }

  .section-label {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  h2 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.7rem, 3.2vw, 2.35rem);
    letter-spacing: -0.03em;
  }

  .lede {
    margin: 0 0 2.25rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  /* Completely open form – no card box */
  .form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .row {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 540px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label span {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--text-dim);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: rgba(59, 130, 246, 0.55);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
    background: rgba(255, 255, 255, 0.06);
  }

  textarea {
    resize: vertical;
    min-height: 5.5rem;
  }

  .hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  /* Quieter button, closer to Resend */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    padding: 0.8rem 1.75rem;
    border: none;
    border-radius: 999px;
    background: #3b82f6;
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s, box-shadow 0.15s, opacity 0.15s, transform 0.15s;
  }

  .btn:hover:not(:disabled) {
    background: #2563eb;
    box-shadow: 0 0 24px rgba(59, 130, 246, 0.35);
  }

  .btn:active:not(:disabled) {
    transform: translateY(1px);
  }

  .btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .status {
    margin: 0.5rem 0 0;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.9rem;
  }

  .status.success {
    background: rgba(52, 211, 153, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.3);
    color: #6ee7b7;
  }

  .status.error {
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.3);
    color: #fca5a5;
  }

  .note {
    margin: 1.75rem 0 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .note a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .note a:hover {
    color: var(--text);
  }

  /* —— Cube visual —— */
  .visual {
    display: none;
    position: relative;
    height: 100%;
    min-height: 380px;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .visual {
      display: block;
    }
  }

  .cube {
    position: absolute;
    right: -8%;
    top: 50%;
    transform: translateY(-52%);
    width: min(52vw, 520px);
    height: auto;
    max-width: none;
    object-fit: contain;
    /* remove any black box / letterboxing feel */
    background: transparent;
    mix-blend-mode: lighten;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.55));
  }

  /* soft radial glow behind the cube so it feels grounded */
  .visual::before {
    content: "";
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    width: min(48vw, 460px);
    height: min(48vw, 460px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(59, 130, 246, 0.12) 0%,
      rgba(34, 211, 238, 0.04) 35%,
      transparent 70%
    );
    pointer-events: none;
  }

  /* Mobile: hide the heavy visual, keep the form clean */
  @media (max-width: 899px) {
    .bg-image {
      opacity: 0.18;
      right: -20%;
      width: 90vw;
    }
  }
</style>