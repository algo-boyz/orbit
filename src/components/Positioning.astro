---
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);

const points = [
  { title: t('pos.1.title'), body: t('pos.1.body') },
  { title: t('pos.2.title'), body: t('pos.2.body') },
  { title: t('pos.3.title'), body: t('pos.3.body') },
];
---

<section class="positioning">
  <div class="inner">
    <p class="section-label">{t('pos.label')}</p>
    <h2>{t('pos.title')}</h2>
    <div class="grid">
      {points.map((p) => (
        <article class="card">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .positioning {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .section-label {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  h2 {
    margin: 0 0 2.5rem;
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    max-width: 20ch;
  }

  .grid {
    display: grid;
    gap: 1.25rem;
  }

  .card {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--border);
  }

  .card h3 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
