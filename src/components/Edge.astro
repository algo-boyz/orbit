---
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);
---

<section class="edge" id="edge">
  <!-- Background image -->
  <div class="edge-bg" aria-hidden="true"></div>
  <!-- Optional dark overlay for text readability -->
  <div class="edge-overlay" aria-hidden="true"></div>

  <div class="inner">
    <div class="copy">
      <p class="section-label">{t('edge.label')}</p>
      <h2>{t('edge.title')}</h2>
      <p class="lede">{t('edge.body')}</p>
    </div>
  </div>
</section>

<style>
  .edge {
    position: relative;
    border-top: 1px solid var(--border);
    overflow: hidden;
    min-height: 650px;
  }

  .edge-bg {
    position: absolute;
    inset: 0;
    background-image: url('../assets/jetson.png'); /* adjust path if needed */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .edge-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(7, 9, 15, 0.75) 0%,
      rgba(7, 9, 15, 0.55) 40%,
      rgba(7, 9, 15, 0.8) 100%
    );
    z-index: 1;
  }

  .inner {
    position: relative;
    z-index: 2;
    max-width: var(--max);
    margin: 0 auto;
    padding: 4.5rem 1.5rem;
    display: grid;
    gap: 3rem;
  }

  .section-label {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    max-width: 22ch;
  }

  .lede {
    margin: 0;
    max-width: 36rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .pillars {
    display: grid;
    gap: 1rem;
  }

  .pillar {
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: rgba(18, 23, 34, 0.6);
  }

  .pillar h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }

  .pillar p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (min-width: 768px) {
    .inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
