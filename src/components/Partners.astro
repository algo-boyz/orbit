---
import grok from '../assets/banner/grok.png';
import jetson from '../assets/banner/jetson.png';
import nvidia from '../assets/banner/nvidia_golden.png';
import rfdetr from '../assets/banner/rfdetr.png';
import veruvian from '../assets/banner/logo.svg';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);

const partners = [
  { src: nvidia.src, alt: 'NVIDIA' },
  { src: grok.src, alt: 'Grok / xAI' },
  { src: jetson.src, alt: 'Jetson' },
  { src: rfdetr.src, alt: 'RF-DETR' },
  { src: veruvian.src, alt: 'AJ' },
];

// Duplicate for seamless infinite loop
const logos = [...partners, ...partners];
---

<section class="partners" aria-label="Partners">
  <div class="inner">
    <div class="section-head">
      <p class="section-label">{t('partners.label')}</p>
      <span class="section-rule" aria-hidden="true"></span>
    </div>

    <div class="marquee">
      <div class="track">
        {logos.map((p) => (
          <div class="logo-item">
            <img
              src={p.src}
              alt={p.alt}
              class="logo"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .partners {
    border-top: 1px solid var(--border);
    background: var(--bg);
    overflow: hidden;
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 2.75rem 1.5rem 3rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .section-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .track {
    display: flex;
    width: max-content;
    gap: 4.5rem;
    animation: scroll 28s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .logo-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    opacity: 0.72;
    transition: opacity 0.25s ease, filter 0.25s ease;
  }

  .logo-item:hover {
    opacity: 1;
  }

  .logo {
    height: 2.75rem;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: grayscale(0.35) brightness(1.05);
  }

  .logo-item:hover .logo {
    filter: grayscale(0) brightness(1.1);
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2.5rem;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .track {
      gap: 3rem;
      animation-duration: 22s;
    }

    .logo {
      height: 2.25rem;
      max-width: 130px;
    }
  }
</style>