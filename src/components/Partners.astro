---
import { Image } from 'astro:assets';
import cloudflare from '../assets/banner/cloudflare.png';
import cpp from '../assets/banner/cpp.png';
import grok from '../assets/banner/grok.jpeg';
import jetson from '../assets/banner/jetson.png';
import linux from '../assets/banner/linux.png';
import nvidia from '../assets/banner/nvidia.png';
import rfdetr from '../assets/banner/rfdetr.png';
import veruvian from '../assets/banner/veruvian.png';
import bannerBg from '../assets/banner_bg.png';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);

const partners = [
  { src: nvidia,     alt: 'NVIDIA',     href: 'https://www.nvidia.com', class: 'logo nvidia' },
  { src: grok,       alt: 'Grok / xAI', href: 'https://x.ai',           class: 'logo' },
  { src: linux,      alt: 'Linux',      href: 'https://www.linuxfoundation.org/', class: 'logo' },
  { src: jetson,     alt: 'Jetson',     href: 'https://www.nvidia.com/en-us/autonomous-machines/embedded-systems/jetson-orin/', class: 'logo' },
  { src: rfdetr,     alt: 'RF-DETR',    href: 'https://rfdetr.roboflow.com', class: 'logo' },
  { src: veruvian,   alt: 'AJ',         href: 'https://agentjetson.ai',   class: 'logo' },
  { src: cpp,        alt: 'CPP',        href: 'https://isocpp.org/', class: 'logo' },
  { src: cloudflare, alt: 'CloudFlare', href: 'https://www.cloudflare.com', class: 'logo cloudflare' },
];

const logos = [...partners, ...partners];
---

<section class="partners" aria-label="Partners">
  <div class="inner">
    <div class="section-head">
      <p class="section-label">{t('partners.label')}</p>
      <span class="section-rule" aria-hidden="true"></span>
    </div>

    <div class="marquee">
      <div class="track">
        {logos.map((p) => (
          <a
            href={p.href}
            class="logo-item"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={p.alt}
          >
            <Image
              src={p.src}
              alt={p.alt}
              class={p.class}
              widths={[120, 180, 240]}
              sizes="(max-width: 640px) 130px, 180px"
              loading="lazy"
              decoding="async"
            />
            <span class="hovercard" aria-hidden="true">{p.alt}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style define:vars={{ bannerBg: `url(${bannerBg.src})` }}>
  .partners {
    border-top: 1px solid var(--border);
    background:
      linear-gradient(rgba(7, 9, 15, 0.72), rgba(7, 9, 15, 0.72)),
      var(--bannerBg) center / cover no-repeat;
    overflow: hidden;
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 2.75rem 1.5rem 3rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .section-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .track {
    display: flex;
    width: max-content;
    gap: 5rem;
    animation: scroll 28s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .logo-item {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.25rem;
    opacity: 0.78;
    transition: opacity 0.25s ease;
    text-decoration: none;
  }

  .logo-item:hover {
    opacity: 1;
  }

  .logo {
    height: 3.5rem;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    filter: grayscale(0.3) brightness(1.08);
    transition: filter 0.25s ease;
  }

  .logo.nvidia {
    filter: grayscale(0.15) brightness(1.15) contrast(1.05);
    mix-blend-mode: lighten;
  }

  .logo.cloudflare {
    height: 2.75rem;          /* was 3.5rem – tweak as needed */
    max-width: 160px;
  }

  @media (max-width: 640px) {
    .logo.cloudflare {
      height: 3rem;           /* mobile override */
    }
  }

  .logo-item:hover .logo {
    filter: grayscale(0) brightness(1.15);
  }

  .logo-item:hover .logo.nvidia {
    filter: grayscale(0) brightness(1.2) contrast(1.05);
  }

  /* ===== Hovercard – small bar slightly below the logo ===== */
  .hovercard {
    position: absolute;
    left: 50%;
    bottom: -0.35rem;                 /* ← pushed a little lower */
    transform: translateX(-50%) translateY(6px);

    padding: 0.28rem 0.65rem;
    background: rgba(8, 10, 18, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;

    color: #f0f2f7;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;

    z-index: 10;
  }

  .logo-item:hover .hovercard {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2.5rem;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .track {
      gap: 3.25rem;
      animation-duration: 22s;
    }

    .logo-item {
      height: 4.5rem;
    }

    .logo {
      height: 3.85rem;
      max-width: 200px;
    }
  }
</style>