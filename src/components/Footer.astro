---
import { useTranslations } from '../i18n/ui';
import logo from '../assets/agentjetson.png';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'en';

const homeHref = locale === 'en' ? '/' : `/${locale}/`;
const investorsHref = locale === 'en' ? '/investors' : `/${locale}/investors`;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <!-- Brand column -->
    <div class="brand">
      <a href={homeHref} class="logo" aria-label={t('nav.homeAria')}>
        <img src={logo.src} alt="AgentJetson" width="104" height="104" class="mark" />
      </a>
      <div class="brand-text">
        <strong>AJ</strong>
        <p>{t('footer.tagline')}</p>
      </div>
    </div>

    <!-- Company / legal column -->
    <div class="company">
      <p class="developed">
        Developed by <strong>AlgoBoyz BV</strong>
      </p>
      <p class="kvk">KvK: 93032080</p>
     
      <!-- Social links -->
      <div class="socials">
         <p class="links">
          <a href={investorsHref}>{t('footer.investors')}</a>
        </p>
        <a
          href="https://x.com/agentjetson"
          class="social icon-twitter icon-trim"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X / Twitter"
        >
          <span>Tweet</span>
        </a>
        <a
          href="https://www.linkedin.com/in/agent-jetson-a8182443a/"
          class="social linkedin icon-trim"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg class="linkedin-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="meta">
      <p>© {year} AgentJetson.ai</p>
      <p>{t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  /* Fontello icons (from project vendor) */
  @font-face {
    font-family: "fontello";
    src: url("/vendor/wormhole-extreme/dist/font/fontello.eot?79140090");
    src: url("/vendor/wormhole-extreme/dist/font/fontello.eot?79140090#iefix") format("embedded-opentype"),
         url("/vendor/wormhole-extreme/dist/font/fontello.woff2?79140090") format("woff2"),
         url("/vendor/wormhole-extreme/dist/font/fontello.woff?79140090") format("woff"),
         url("/vendor/wormhole-extreme/dist/font/fontello.ttf?79140090") format("truetype"),
         url("/vendor/wormhole-extreme/dist/font/fontello.svg?79140090#fontello") format("svg");
    font-weight: normal;
    font-style: normal;
  }

  [class^="icon-"]:before,
  [class*=" icon-"]:before {
    display: inline-block;
    margin: 0 0.35em 0 0;
    padding: 0;
    width: 1em;
    font-family: "fontello";
    font-style: normal;
    font-weight: normal;
    font-variant: normal;
    text-transform: none;
    text-decoration: inherit;
    text-align: center;
    line-height: 1em;
    speak: none;
  }

  .icon-trim:before {
    margin: 0;
  }

  .icon-twitter:before {
    content: "\f099";
  }

  .icon-github:before {
    content: "\f113";
  }

  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 3.25rem 1.5rem 3rem;
    display: grid;
    gap: 2.5rem;
  }

  /* ——— Brand ——— */
  .brand {
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }

  .logo {
    display: block;
    flex-shrink: 0;
  }

  .mark {
    width: 6.5rem;          /* noticeably larger */
    height: 6.5rem;
    border-radius: 16px;
    object-fit: contain;
    animation: pulse-glow 3.2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% {
      filter: drop-shadow(0 0 0 rgba(59, 130, 246, 0));
      transform: scale(1);
    }
    50% {
      filter: drop-shadow(0 0 14px rgba(59, 130, 246, 0.6));
      transform: scale(1.04);
    }
  }

  .brand-text strong {
    display: block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-text p {
    margin: 0.35rem 0 0;
    color: var(--text-dim);
    font-size: 0.95rem;
    max-width: 24rem;
    line-height: 1.45;
  }

  /* ——— Company info ——— */
  .company {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.55;
  }

  .developed strong {
    color: var(--text);
    font-weight: 500;
  }

  .kvk {
    margin: 0.4rem 0 0.85rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--text-dim);
  }

  .links a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.9rem;
  }

  .links a:hover {
    color: var(--text);
  }

  /* ——— Socials ——— */
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .social {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    transition: color 0.25s ease, background 0.25s ease, border-color 0.25s ease;
    white-space: nowrap;
  }

  .social:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-strong);
  }

  /* Hide label by default, reveal on hover (matches wormhole btn pattern) */
  .social > span {
    display: inline-block;
    overflow: hidden;
    margin: 0;
    padding: 0;
    max-width: 0;
    opacity: 0;
    vertical-align: middle;
    transition: max-width 0.3s ease, opacity 0.25s ease, margin 0.3s ease;
  }

  .social:hover > span {
    max-width: 6rem;
    opacity: 1;
    margin-left: 0.4rem;
  }

  /* LinkedIn SVG icon sizing to match font icons */
  .linkedin-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    display: inline-block;
    vertical-align: middle;
  }

  /* When LinkedIn has icon + span, ensure spacing */
  .social.linkedin {
    gap: 0; /* controlled by span margin */
  }

  /* ——— Copyright ——— */
  .meta {
    color: var(--text-dim);
    font-size: 0.825rem;
  }

  .meta p {
    margin: 0.15rem 0;
  }

  /* Desktop layout */
  @media (min-width: 768px) {
    .inner {
      grid-template-columns: 1.5fr 1fr auto;
      align-items: end;
      gap: 2.5rem;
    }

    .meta {
      text-align: right;
    }
  }
</style>
