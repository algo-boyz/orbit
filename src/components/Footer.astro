---
import { useTranslations } from '../i18n/ui';
import logo from '../assets/agentjetson.png';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'en';

const homeHref = locale === 'en' ? '/' : `/${locale}/`;
const investorsHref = locale === 'en' ? '/investors' : `/${locale}/investors`;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <!-- Brand column -->
    <div class="brand">
      <a href={homeHref} class="logo" aria-label={t('nav.homeAria')}>
        <img src={logo.src} alt="AgentJetson" width="104" height="104" class="mark" />
      </a>
      <div class="brand-text">
        <strong>AJ</strong>
        <p>{t('footer.tagline')}</p>
      </div>
    </div>

    <!-- Company / legal column -->
    <div class="company">
      <p class="developed">
        Developed by <strong>AlgoBoyz BV</strong> in Amsterdam
      </p>
      <p class="kvk">KvK: 93032080</p>
      <p class="links">
        <a href={investorsHref}>{t('footer.investors')}</a>
      </p>
    </div>

    <!-- Copyright -->
    <div class="meta">
      <p>© {year} AgentJetson.ai</p>
      <p>{t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 3.25rem 1.5rem 3rem;
    display: grid;
    gap: 2.5rem;
  }

  /* ——— Brand ——— */
  .brand {
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }

  .logo {
    display: block;
    flex-shrink: 0;
  }

  .mark {
    width: 6.5rem;          /* noticeably larger */
    height: 6.5rem;
    border-radius: 16px;
    object-fit: contain;
    animation: pulse-glow 3.2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% {
      filter: drop-shadow(0 0 0 rgba(59, 130, 246, 0));
      transform: scale(1);
    }
    50% {
      filter: drop-shadow(0 0 14px rgba(59, 130, 246, 0.6));
      transform: scale(1.04);
    }
  }

  .brand-text strong {
    display: block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-text p {
    margin: 0.35rem 0 0;
    color: var(--text-dim);
    font-size: 0.95rem;
    max-width: 24rem;
    line-height: 1.45;
  }

  /* ——— Company info ——— */
  .company {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.55;
  }

  .developed strong {
    color: var(--text);
    font-weight: 500;
  }

  .kvk {
    margin: 0.4rem 0 0.85rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--text-dim);
  }

  .links a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.9rem;
  }

  .links a:hover {
    color: var(--text);
  }

  /* ——— Copyright ——— */
  .meta {
    color: var(--text-dim);
    font-size: 0.825rem;
  }

  .meta p {
    margin: 0.15rem 0;
  }

  /* Desktop layout */
  @media (min-width: 768px) {
    .inner {
      grid-template-columns: 1.5fr 1fr auto;
      align-items: end;
      gap: 2.5rem;
    }

    .meta {
      text-align: right;
    }
  }
</style>