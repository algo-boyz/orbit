---
/**
 * Optional standalone wormhole overlay.
 * Prefer IntroExperience for the homepage boot sequence.
 * Use this if you want link-triggered wormhole navigation elsewhere.
 */
---
<div class="wormhole-overlay" data-wormhole-transition aria-hidden="true" inert>
  <canvas class="wormhole-overlay__canvas" aria-hidden="true"></canvas>
  <div class="wormhole-overlay__core" aria-hidden="true"></div>
  <p class="wormhole-overlay__message">Entering Agent Jetson</p>
  <button class="wormhole-overlay__skip" type="button">Skip</button>
</div>
<script>
  import { mountWormholeTransition } from "../../scripts/wormhole-transition";
  mountWormholeTransition();
</script>
