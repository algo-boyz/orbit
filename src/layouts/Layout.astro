---
import { locales, defaultLocale, type Locale } from '../i18n/config';

interface Props {
  title?: string;
  description?: string;
  /** Override OG/Twitter image (absolute or site-relative path) */
  image?: string;
  /** Open Graph type — use "article" for blog posts */
  ogType?: 'website' | 'article';
  /** ISO date for articles */
  publishedTime?: string;
  /** ISO date for articles */
  modifiedTime?: string;
  /** Author name for articles */
  author?: string;
}

const SITE = 'https://www.agentjetson.ai';
const DEFAULT_OG_IMAGE = `${SITE}/og-image.png`;

const {
  title = 'AgentJetson.ai — Intelligence at the edge of every encounter',
  description = 'Sovereign edge AI that turns live video into real-time detection and operational intelligence for public safety. Defense-grade. Human-governed. Sovereign.',
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const canonicalURL = new URL(Astro.url.pathname, SITE).href;

// Absolute image URL
const ogImage = image.startsWith('http') ? image : new URL(image, SITE).href;

// Map locale → og:locale
const ogLocaleMap: Record<Locale, string> = {
  ar: 'ar_SA',
  en: 'en_US',
  es: 'es_ES',
  fr: 'fr_FR',
  de: 'de_DE',
  nl: 'nl_NL',
};

// Build hreflang alternates for the current path
function localePath(locale: Locale, pathname: string): string {
  // Strip existing locale prefix if present
  let path = pathname;
  for (const l of locales) {
    if (l === defaultLocale) continue;
    if (path === `/${l}` || path.startsWith(`/${l}/`)) {
      path = path.slice(l.length + 1) || '/';
      break;
    }
  }
  if (!path.startsWith('/')) path = `/${path}`;
  if (locale === defaultLocale) return `${SITE}${path}`;
  // Avoid double slash
  return path === '/' ? `${SITE}/${locale}/` : `${SITE}/${locale}${path}`;
}

const pathname = Astro.url.pathname;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AgentJetson',
  legalName: 'AlgoBoyz BV',
  url: SITE,
  logo: `${SITE}/og-image.png`,
  description:
    'Sovereign edge AI that turns live video into real-time detection and operational intelligence for public safety.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Amsterdam',
    addressCountry: 'NL',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@agentjetson.ai',
    contactType: 'sales',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AgentJetson',
  url: SITE,
  description,
  publisher: { '@type': 'Organization', name: 'AgentJetson' },
  inLanguage: locales,
};

const articleJsonLd =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage,
        datePublished: publishedTime,
        dateModified: modifiedTime ?? publishedTime,
        author: {
          '@type': 'Person',
          name: author ?? 'AgentJetson Team',
        },
        publisher: {
          '@type': 'Organization',
          name: 'AgentJetson',
          logo: {
            '@type': 'ImageObject',
            url: `${SITE}/og-image.png`,
          },
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalURL,
        },
      }
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090f" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang alternates -->
    {
      locales.map((locale) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={localePath(locale, pathname)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={localePath(defaultLocale, pathname)} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="AgentJetson" />
    <meta property="og:locale" content={ogLocaleMap[lang]} />
    {
      locales
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={ogLocaleMap[l]} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={title} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/og-image.png" />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {
      articleJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #07090f;
    --bg-elevated: #0d111a;
    --bg-card: #121722;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.14);
    --text: #f4f6fb;
    --text-muted: #9aa3b5;
    --text-dim: #6b7385;
    --accent: #3b82f6;
    --accent-soft: rgba(59, 130, 246, 0.15);
    --accent-glow: rgba(59, 130, 246, 0.35);
    --cyan: #22d3ee;
    --success: #34d399;
    --radius: 14px;
    --radius-lg: 20px;
    --max: 1120px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: Inter, system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: "Space Grotesk", Inter, sans-serif;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  button {
    font-family: inherit;
  }
</style>
