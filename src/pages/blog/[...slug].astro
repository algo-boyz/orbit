---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'en';

const title = `${post.data.title} — AgentJetson`;
const description = post.data.description;
---

<Layout title={title} description={description}>
  <Header />
  <main class="post">
    <article class="inner">
      <header class="post-header">
        <a href="/blog/" class="back">{t('blog.back') || '← All posts'}</a>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString(locale, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <h1>{post.data.title}</h1>
        {post.data.heroImage && (
          <figure class="hero-image">
            <Image
              src={post.data.heroImage}
              alt={post.data.heroImageAlt ?? ''}
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 800px"
            />
            {post.data.heroImageAlt && <figcaption>{post.data.heroImageAlt}</figcaption>}
          </figure>
        )}
        <p class="description">{post.data.description}</p>
        {
          post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .post {
    padding: 2.5rem 0 5rem;
  }

  .inner {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .back:hover {
    color: var(--accent);
  }

  time {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    line-height: 1.2;
  }

  .description {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .prose {
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin: 2.25rem 0 0.85rem;
    font-size: 1.35rem;
  }

  .prose :global(h3) {
    margin: 1.75rem 0 0.65rem;
    font-size: 1.15rem;
  }

  .prose :global(p) {
    margin: 0 0 1.15rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.15rem;
    padding-left: 1.35rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: #60a5fa;
  }

  .prose :global(hr) {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--border);
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-card);
    color: var(--text-muted);
  }
</style>
